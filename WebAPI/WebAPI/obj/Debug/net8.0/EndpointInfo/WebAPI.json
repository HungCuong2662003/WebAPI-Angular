  "components": {
    "schemas": {
      "GameMatches": {
        "required": [
          "playerOID",
          "playerXID",
          "roomId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "playerXID": {
            "minLength": 1,
            "type": "string"
          },
          "playerOID": {
            "minLength": 1,
            "type": "string"
          },
          "winnerID": {
            "type": "string",
            "nullable": true
          },
          "moves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Moves"
            },
            "nullable": true
          },
          "createAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "JoinRoomRequest": {
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Moves": {
        "required": [
          "matchID",
          "playerID",
          "x",
          "y"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "matchID": {
            "type": "string",
            "format": "uuid"
          },
          "gameMatch": {
            "$ref": "#/components/schemas/GameMatches"
          },
          "playerID": {
            "minLength": 1,
            "type": "string"
          },
          "x": {
            "type": "integer",
            "format": "int32"
          },
          "y": {
            "type": "integer",
            "format": "int32"
          },
          "createAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Rooms": {
        "required": [
          "isPublic",
          "maxPlayers",
          "ownerID",
          "roomCode",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roomCode": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "ownerID": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/User"
          },
          "passwordRoom": {
            "maxLength": 6,
            "type": "string",
            "nullable": true
          },
          "isPublic": {
            "type": "boolean"
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            },
            "nullable": true
          },
          "maxPlayers": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "createAt": {
            "type": "string",
            "format": "date-time"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameMatches"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SignInModel": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SignUpModel": {
        "required": [
          "confirmPass",
          "email",
          "firstname",
          "lastname",
          "password"
        ],
        "type": "object",
        "properties": {
          "firstname": {
            "minLength": 1,
            "type": "string"
          },
          "lastname": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "confirmPass": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "userName": {
            "type": "string",
